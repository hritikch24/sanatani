# Neon Postgres connection string
# Get this from your Neon dashboard → Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Secret salt used to hash visitor IPs for the /upasthiti presence counter.
# We never store raw IPs — only sha256(IP_SALT + ip). Use a long random string.
# Changing this resets every visitor identity (counts start fresh).
IP_SALT=change-me-to-a-long-random-string

# Google Search Console verification token (optional).
# Paste only the content value of the meta tag, not the whole tag.
GOOGLE_SITE_VERIFICATION=
